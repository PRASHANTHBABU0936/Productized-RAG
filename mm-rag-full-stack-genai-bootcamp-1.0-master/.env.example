OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
QDRANT_API_KEY=
QDRANT_Cluster_Endpoint=
QDRANT_URL=
QDRANT_COLLECTION_NAME=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSION=
TESSERACT_PATH=

# OCR: Tesseract is primary; EasyOCR (CPU) is the fallback used when
# Tesseract is unavailable or returns little/no text on scanned
# pages/images. Set EASYOCR_ENABLED=false to disable the fallback.
EASYOCR_ENABLED=true
EASYOCR_LANGUAGES=en

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_VISION_MODEL=moondream
OLLAMA_VISION_TIMEOUT=180

# Embeddings (server-side HuggingFace MiniLM model)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_DIMENSION=384

# PostgreSQL + Celery / Redis
DATABASE_URL=postgresql+psycopg://mmrag:mmrag_password@localhost:5433/mmrag
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-this-secret-in-production

# Streamlit -> FastAPI
MM_RAG_API_URL=http://localhost:8000

# Object storage: local (default) or s3 (S3 / MinIO / R2)
STORAGE_BACKEND=local
STORAGE_ROOT=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
